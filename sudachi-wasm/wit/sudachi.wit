package sudachi:tokenizer;

world sudachi {
    export api;
}

interface api {
    /// Load dictionary from .xdic bytes and return a handle id
    load-dictionary: func(xdic-bytes: list<u8>) -> result<u32, string>;
    /// Tokenize text, returns list of (surface, reading, part-of-speech)
    tokenize: func(handle: u32, text: string, mode: u8) -> result<list<tuple<string, string, string>>, string>;
    /// Free a dictionary handle
    free-dictionary: func(handle: u32);
}
